# Database — Neon serverless Postgres.
# DATABASE_URL is the pooled connection used at runtime; DIRECT_URL is the
# unpooled one Prisma Migrate needs. Both come from the Neon dashboard.
DATABASE_URL=
DIRECT_URL=

# Auth.js v5. Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
AUTH_URL=

# Seeded on first run by prisma/seed.ts. Change the password after first login.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Cloudinary — image storage and transforms.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend — transactional email for enquiry notifications.
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=

# Upstash Redis — rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
